rules_version = '2';

// This app's frontend never talks to Firestore directly — every read/write
// goes through the backend (server.js), which uses firebase-admin and
// verifies the caller's ID token itself (see backend/src/lib/auth.js), then
// only ever queries `where userId == <verified uid>`. The Admin SDK bypasses
// these rules entirely, so they are NOT what makes user isolation work today
// — that's enforced server-side. These rules exist as defense-in-depth (in
// case a client-side Firestore read is ever added later) and to make the
// intended access model explicit and auditable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      // A user may only read their own project documents.
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      // No direct client writes at all — only the backend (Admin SDK,
      // which bypasses these rules) creates/updates/deletes project docs.
      // This prevents a compromised or malicious client from forging
      // another user's project, faking a completed status, or inflating
      // clip counts past the enforced limits.
      allow write: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
